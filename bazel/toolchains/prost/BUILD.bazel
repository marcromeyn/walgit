load("@rules_rust//rust:defs.bzl", "rust_library_group")
load("@rules_rust_prost//:defs.bzl", "rust_prost_toolchain")

package(default_visibility = ["//visibility:public"])

rust_library_group(
    name = "prost_runtime",
    deps = ["@walgit_crates//:prost"],
)

rust_library_group(
    name = "tonic_runtime",
    deps = [
        ":prost_runtime",
        "@walgit_prost_crates//:tonic",
    ],
)

rust_prost_toolchain(
    name = "impl",
    compile_well_known_types = False,
    prost_opts = ["bytes=."],
    prost_plugin = "@walgit_prost_crates//:protoc-gen-prost__protoc-gen-prost",
    prost_runtime = ":prost_runtime",
    prost_types = "@walgit_crates//:prost-types",
    tonic_plugin = "@walgit_prost_crates//:protoc-gen-tonic__protoc-gen-tonic",
    tonic_runtime = ":tonic_runtime",
)

toolchain(
    name = "toolchain",
    toolchain = ":impl",
    toolchain_type = "@rules_rust_prost//:toolchain_type",
)
