load("//bazel:defs.bzl", "walgit_rust_crate")

walgit_rust_crate(
    name = "walgit-store",
    crate_name = "walgit_store",
    crate_features = ["gcs", "s3"],
    deps = [
        "//crates/walgit-config",
        "//crates/walgit-proto",
        "@walgit_crates//:anyhow",
        "@walgit_crates//:aws-config",
        "@walgit_crates//:aws-sdk-s3",
        "@walgit_crates//:aws-smithy-types",
        "@walgit_crates//:bytes",
        "@walgit_crates//:futures",
        "@walgit_crates//:google-cloud-auth",
        "@walgit_crates//:google-cloud-gax",
        "@walgit_crates//:google-cloud-storage",
        "@walgit_crates//:hex",
        "@walgit_crates//:http",
        "@walgit_crates//:metrics",
        "@walgit_crates//:parking_lot",
        "@walgit_crates//:prost",
        "@walgit_crates//:rand",
        "@walgit_crates//:reqwest",
        "@walgit_crates//:serde",
        "@walgit_crates//:thiserror",
        "@walgit_crates//:tokio",
        "@walgit_crates//:tokio-stream",
        "@walgit_crates//:tokio-util",
        "@walgit_crates//:tracing",
        "@walgit_crates//:uuid",
    ],
    proc_macro_deps = ["@walgit_crates//:async-trait"],
    test_deps = [
        "@walgit_crates//:axum",
        "@walgit_crates//:bytesize",
        "@walgit_crates//:rustls",
        "@walgit_crates//:sha1",
        "@walgit_crates//:tempfile",
    ],
)
